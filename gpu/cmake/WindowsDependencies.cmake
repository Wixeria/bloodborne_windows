# Native LLVM-MinGW dependencies; Linux keeps its system package setup.
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
set(BB_GPU_DEPS "${CMAKE_CURRENT_SOURCE_DIR}/../out/toolchains" CACHE PATH "Pinned Windows renderer dependency directory")
foreach(dep Vulkan-Headers-GPU fmt magic_enum robin-map VulkanMemoryAllocator xxHash xbyak miniz-3.1.2 zydis glslang boost_1_88_0)
    if(NOT IS_DIRECTORY "${BB_GPU_DEPS}/${dep}")
        message(FATAL_ERROR "Missing ${dep}; run tools/windows/bootstrap-gpu.ps1 and bootstrap.ps1 -Media")
    endif()
endforeach()
add_compile_definitions(NOMINMAX WIN32_LEAN_AND_MEAN _WIN32_WINNT=0x0A00)
# libc++ does not provide the incidental global malloc/free declarations that
# several vendored headers rely on.
add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include cstdlib>")
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(FMT_TEST OFF CACHE BOOL "" FORCE)
set(FMT_INSTALL OFF CACHE BOOL "" FORCE)
add_subdirectory("${BB_GPU_DEPS}/fmt" "${CMAKE_CURRENT_BINARY_DIR}/deps/fmt" EXCLUDE_FROM_ALL)
add_subdirectory("${BB_GPU_DEPS}/Vulkan-Headers-GPU" "${CMAKE_CURRENT_BINARY_DIR}/deps/vulkan-headers" EXCLUDE_FROM_ALL)
add_library(bb-boost INTERFACE)
add_library(Boost::headers ALIAS bb-boost)
target_include_directories(bb-boost SYSTEM INTERFACE "${BB_GPU_DEPS}/boost_1_88_0")
target_compile_definitions(bb-boost INTERFACE BOOST_ERROR_CODE_HEADER_ONLY)
set_source_files_properties(shadps4/shader_recompiler/ir/passes/flatten_extended_userdata_pass.cpp
    PROPERTIES COMPILE_OPTIONS "-isystem;${BB_GPU_DEPS}/xbyak")
add_subdirectory("${BB_GPU_DEPS}/magic_enum" "${CMAKE_CURRENT_BINARY_DIR}/deps/magic-enum" EXCLUDE_FROM_ALL)
add_subdirectory("${BB_GPU_DEPS}/robin-map" "${CMAKE_CURRENT_BINARY_DIR}/deps/robin-map" EXCLUDE_FROM_ALL)
add_subdirectory("${BB_GPU_DEPS}/VulkanMemoryAllocator" "${CMAKE_CURRENT_BINARY_DIR}/deps/vma" EXCLUDE_FROM_ALL)
add_library(bb-xxhash STATIC "${BB_GPU_DEPS}/xxHash/xxhash.c")
add_library(PkgConfig::XXHASH ALIAS bb-xxhash)
target_include_directories(bb-xxhash PUBLIC "${BB_GPU_DEPS}/xxHash")
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(INSTALL_PROJECT OFF CACHE BOOL "" FORCE)
add_subdirectory("${BB_GPU_DEPS}/miniz-3.1.2" "${CMAKE_CURRENT_BINARY_DIR}/deps/miniz" EXCLUDE_FROM_ALL)
add_library(miniz::miniz ALIAS miniz)
set(ZYDIS_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
set(ZYDIS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(ZYDIS_BUILD_DOXYGEN OFF CACHE BOOL "" FORCE)
add_subdirectory("${BB_GPU_DEPS}/zydis" "${CMAKE_CURRENT_BINARY_DIR}/deps/zydis" EXCLUDE_FROM_ALL)
add_library(Zydis::Zydis ALIAS Zydis)
find_package(SDL3 CONFIG REQUIRED)
add_library(bb-gpu-sdl INTERFACE)
target_link_libraries(bb-gpu-sdl INTERFACE SDL3::SDL3)
add_library(PkgConfig::SDL3 ALIAS bb-gpu-sdl)
add_library(bb-ffmpeg INTERFACE)
add_library(PkgConfig::FFMPEG ALIAS bb-ffmpeg)
set(BB_FFMPEG_ROOT "${BB_GPU_DEPS}/ffmpeg-n8.1.3-14-g330caae0c1-win64-lgpl-shared-8.1" CACHE PATH "FFmpeg shared development prefix")
target_include_directories(bb-ffmpeg SYSTEM INTERFACE "${BB_FFMPEG_ROOT}/include")
foreach(component avformat avcodec avutil swscale swresample)
    find_library(BB_FFMPEG_${component} NAMES ${component} PATHS "${BB_FFMPEG_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
    target_link_libraries(bb-ffmpeg INTERFACE "${BB_FFMPEG_${component}}")
endforeach()

# FSR calls the Vulkan C API directly. Generate a MinGW import library from the
# installed system loader without depending on a machine-wide Vulkan SDK.
get_filename_component(bb_compiler_bin "${CMAKE_C_COMPILER}" DIRECTORY)
set(bb_vk_dll "$ENV{SystemRoot}/System32/vulkan-1.dll")
execute_process(COMMAND "${bb_compiler_bin}/llvm-readobj.exe" --coff-exports "${bb_vk_dll}"
    OUTPUT_VARIABLE bb_vk_exports COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "Name: [a-zA-Z0-9_]+" bb_vk_names "${bb_vk_exports}")
set(bb_vk_def "LIBRARY vulkan-1.dll\nEXPORTS\n")
foreach(entry IN LISTS bb_vk_names)
    string(REPLACE "Name: " "" entry "${entry}")
    string(APPEND bb_vk_def "${entry}\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/vulkan-1.def" "${bb_vk_def}")
execute_process(COMMAND "${bb_compiler_bin}/llvm-dlltool.exe" -m i386:x86-64
    -d "${CMAKE_CURRENT_BINARY_DIR}/vulkan-1.def" -l "${CMAKE_CURRENT_BINARY_DIR}/libvulkan-1.dll.a"
    COMMAND_ERROR_IS_FATAL ANY)
set(Vulkan_INCLUDE_DIR "${BB_GPU_DEPS}/Vulkan-Headers-GPU/include" CACHE PATH "" FORCE)
set(Vulkan_LIBRARY "${CMAKE_CURRENT_BINARY_DIR}/libvulkan-1.dll.a" CACHE FILEPATH "" FORCE)
find_package(Vulkan REQUIRED)
set(ENABLE_OPT OFF CACHE BOOL "" FORCE)
set(GLSLANG_TESTS OFF CACHE BOOL "" FORCE)
set(GLSLANG_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(ENABLE_GLSLANG_BINARIES ON CACHE BOOL "" FORCE)
set(ENABLE_SPVREMAPPER OFF CACHE BOOL "" FORCE)
add_subdirectory("${BB_GPU_DEPS}/glslang" "${CMAKE_CURRENT_BINARY_DIR}/deps/glslang" EXCLUDE_FROM_ALL)
set(GLSLANG_COMPILER "$<TARGET_FILE:glslang-standalone>")
